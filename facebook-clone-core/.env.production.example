# Sao chép thành .env.production trước khi build Docker / deploy VPS

DB_POSTGRES_HOST=postgres-db
DB_POSTGRES_PORT=5432
DB_POSTGRES_USERNAME=admin
DB_POSTGRES_PASSWORD=admin
DB_POSTGRES_DATABASE=facebook_clone

JWT_SECRET=change-me
JWT_EXPIRES=10h
JWT_REFRESH=change-me-too
JWT_REFRESH_EXPIRES=7d

ELASTICSEARCH_NODE=http://elasticsearch:9200
REDIS_HOST=redis-cache
REDIS_PORT=6379
RABBITMQ_URL=amqp://rabbituser:rabbitpassword@rabbitmq:5672
RABBITMQ_QUEUE=myqueue

SUPABASE_URL=
SUPABASE_ANON_KEY=

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://192.168.105.125:3001
PORT=3301

RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Tuỳ chọn — bỏ trống thì API vẫn chạy (DevOps / Docker)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
